# Application settings
APP_NAME=Job Application Tracker API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CREATE_TABLES_ON_STARTUP=true

# Local PostgreSQL settings used by Docker Compose
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
API_PORT=8000

# Used when running FastAPI directly on the host.
DATABASE_URL=postgresql+psycopg://jobtracker:change-me-for-local-development@localhost:5432/jobtracker
